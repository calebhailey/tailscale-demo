architecture-beta
    group aws(cloud)[AWS account · us-east-2]
    group vpc(cloud)[VPC · 10.0.42.0/24] in aws
    group public(cloud)[Public subnets] in vpc
    group private(cloud)[Private subnets] in vpc

    service workstation(server)[Developer workstation]
    service internet(internet)[Internet]
    service tailnet(cloud)[Tailscale tailnet]
    service alb(server)[Internet-facing ALB] in public
    service routers(server)[Subnet-router EC2 instances] in private
    service apps(server)[Demo-app EC2 instances] in private

    workstation:R --> L:tailnet
    workstation:R --> L:internet
    tailnet:R --> L:routers
    internet:R --> L:alb
    alb:R --> L:apps
    routers:B --> T:apps

    align column tailnet internet
